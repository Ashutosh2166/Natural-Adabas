* ============================================================
* SUBPROGRAM: LOYACCR
* PURPOSE   : Accrue frequent flyer miles on flight completion
* ============================================================
DEFINE DATA
PARAMETER
1 P-PNR             (A8)
1 P-STATUS          (I2)
LOCAL
1 BK VIEW OF BOOKING
1 PA VIEW OF PASSENGER
1 FS VIEW OF FLIGHT-SCHEDULE
1 #MILES-EARNED     (P10)
1 #BONUS-MILES      (P10)
1 #NEW-TIER         (A2)
END-DEFINE

RESET P-STATUS

GET BOOKING P-PNR
GET PASSENGER BK-PASSENGER-ID

* Base miles = actual distance
FIND FLIGHT-SCHEDULE WITH FS-FLIGHT-KEY = BK-SEG-FLIGHT-KEY(1)
  MOVE FS-DISTANCE-KM TO #MILES-EARNED
END-FIND

* Apply cabin class multiplier
DECIDE ON FIRST VALUE OF BK-SEG-CABIN-CLASS(1)
  VALUE 'F'
    COMPUTE #BONUS-MILES = #MILES-EARNED * 2.5
  VALUE 'J'
    COMPUTE #BONUS-MILES = #MILES-EARNED * 1.5
  VALUE 'Y'
    MOVE #MILES-EARNED TO #BONUS-MILES
  NONE
    MOVE 0 TO #BONUS-MILES
END-DECIDE

ADD #BONUS-MILES TO PA-LOYALTY-MILES

* Evaluate tier upgrade
IF PA-LOYALTY-MILES >= 100000
  MOVE 'DI' TO #NEW-TIER
ELSE IF PA-LOYALTY-MILES >= 75000
  MOVE 'PL' TO #NEW-TIER
ELSE IF PA-LOYALTY-MILES >= 50000
  MOVE 'GL' TO #NEW-TIER
ELSE IF PA-LOYALTY-MILES >= 25000
  MOVE 'SV' TO #NEW-TIER
ELSE
  MOVE 'BL' TO #NEW-TIER
END-IF

IF #NEW-TIER <> PA-LOYALTY-TIER
  WRITE 'TIER UPGRADE:' PA-PASSENGER-ID
        'FROM:' PA-LOYALTY-TIER 'TO:' #NEW-TIER
  MOVE #NEW-TIER TO PA-LOYALTY-TIER
END-IF

UPDATE (PA)
CALLNAT 'AUDITLOG' 'PA' 'MILES-ADD' BK-PASSENGER-ID
MOVE 0 TO P-STATUS
END