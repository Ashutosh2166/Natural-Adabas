* ============================================================
* PROGRAM : YIELDSIM
* PURPOSE : What-if yield simulation for pricing decisions
* ============================================================
DEFINE DATA LOCAL
1 #CURRENT-PAX      (P6)
1 #CAPACITY         (P6)
1 #CURRENT-FARE     (P9,2)
1 #PRICE-STEP       (P9,2)
1 #SIM-FARE         (P9,2)
1 #SIM-PAX          (P6)
1 #SIM-REVENUE      (P12,2)
1 #BASE-REVENUE     (P12,2)
1 #ELASTICITY       (P4,2)
1 #DELTA-PCT        (P5,2)
1 #SIM-ROUNDS       (I2)
1 #I                (I2)
1 #BEST-FARE       (P9,2)
1 #BEST-REVENUE    (P12,2)
END-DEFINE

INPUT 'FLIGHT CAPACITY:' #CAPACITY
      'CURRENT PAX:' #CURRENT-PAX
      'CURRENT FARE:' #CURRENT-FARE
      'PRICE ELASTICITY (-0.5 to -2.0):' #ELASTICITY
      'SIMULATION ROUNDS:' #SIM-ROUNDS

COMPUTE #BASE-REVENUE = #CURRENT-PAX * #CURRENT-FARE
MOVE #BASE-REVENUE TO #BEST-REVENUE
MOVE #CURRENT-FARE TO #BEST-FARE

WRITE 'BASE REVENUE:' #BASE-REVENUE

FOR #I = 1 TO #SIM-ROUNDS
  COMPUTE #PRICE-STEP = #CURRENT-FARE * (#I - #SIM-ROUNDS/2) / 20
  COMPUTE #SIM-FARE = #CURRENT-FARE + #PRICE-STEP

  IF #SIM-FARE <= 0
    ESCAPE TOP
  END-IF

  COMPUTE #DELTA-PCT = (#SIM-FARE - #CURRENT-FARE)
                     / #CURRENT-FARE * 100
  COMPUTE #SIM-PAX = #CURRENT-PAX *
    (1 + #ELASTICITY * #DELTA-PCT / 100)

  IF #SIM-PAX > #CAPACITY
    MOVE #CAPACITY TO #SIM-PAX
  END-IF
  IF #SIM-PAX < 0
    MOVE 0 TO #SIM-PAX
  END-IF

  COMPUTE #SIM-REVENUE = #SIM-PAX * #SIM-FARE

  WRITE 'ROUND:' #I 'FARE:' #SIM-FARE
        'PAX:' #SIM-PAX 'REVENUE:' #SIM-REVENUE

  IF #SIM-REVENUE > #BEST-REVENUE
    MOVE #SIM-REVENUE TO #BEST-REVENUE
    MOVE #SIM-FARE    TO #BEST-FARE
  END-IF
END-FOR

WRITE ' '
WRITE '=== OPTIMAL PRICING ==='
WRITE 'BEST FARE:' #BEST-FARE
WRITE 'BEST REVENUE:' #BEST-REVENUE
WRITE 'IMPROVEMENT:' #BEST-REVENUE - #BASE-REVENUE
END