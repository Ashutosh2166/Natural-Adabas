* ============================================================
* PROGRAM : PNRPURGE
* PURPOSE : Purge PNRs older than retention policy (13 months)
* ============================================================
DEFINE DATA LOCAL
1 BK VIEW OF BOOKING
1 #TODAY          (A10)
1 #CUTOFF-DATE    (A10)
1 #PURGE-COUNT    (P6)
1 #ARCHIVE-OK     (L)
1 #DAYS-OLD       (I4)
END-DEFINE

MOVE *DATX TO #TODAY
CALLNAT 'DATEADD' #TODAY -395 #CUTOFF-DATE  /* 13 months

WRITE 'PURGE CUTOFF DATE:' #CUTOFF-DATE

FIND BOOKING WITH BK-BOOKING-DATE < #CUTOFF-DATE
  AND BK-BOOKING-STATUS = 'NO' OR 'UC' OR 'CN'
  CALLNAT 'DATDIFF' BK-BOOKING-DATE #TODAY #DAYS-OLD
  CALLNAT 'ARCHIVEBK' BK-PNR-LOCATOR #ARCHIVE-OK
  IF #ARCHIVE-OK = TRUE
    DELETE BOOKING
    ADD 1 TO #PURGE-COUNT
    IF #PURGE-COUNT MOD 1000 = 0
      WRITE 'PURGED SO FAR:' #PURGE-COUNT
    END-IF
  END-IF
END-FIND

WRITE 'PURGE COMPLETE:' #PURGE-COUNT 'RECORDS REMOVED'
END