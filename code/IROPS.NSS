* ============================================================
* PROGRAM : IROPS
* PURPOSE : Handle irregular operations (delays, cancellations)
* ============================================================
DEFINE DATA LOCAL
1 FS VIEW OF FLIGHT-SCHEDULE
1 BK VIEW OF BOOKING
1 #AFFECTED-FLIGHT  (A20)
1 #REASON-CODE      (A2)
1 #DELAY-MIN        (P4)
1 #REACCOM-COUNT    (P6)
1 #PAX-COUNT        (P6)
1 #OPTION           (A1)
END-DEFINE

INPUT 'AFFECTED FLIGHT:' #AFFECTED-FLIGHT
      'REASON (WX/MX/TC/CR):' #REASON-CODE
      'DELAY MINUTES:' #DELAY-MIN
      'ACTION (D=Delay,C=Cancel):' #OPTION

FIND FLIGHT-SCHEDULE WITH FS-FLIGHT-KEY = #AFFECTED-FLIGHT
  IF #OPTION = 'C'
    UPDATE FLIGHT-SCHEDULE
      FS-FLIGHT-STATUS := 'CN'
  ELSE
    UPDATE FLIGHT-SCHEDULE
      FS-FLIGHT-STATUS := 'DL'
  END-IF

  * Find all affected passengers
  RESET #PAX-COUNT #REACCOM-COUNT
  FIND BOOKING WITH BK-SEG-FLIGHT-KEY(1) = #AFFECTED-FLIGHT
                AND BK-BOOKING-STATUS = 'HK'
    ADD 1 TO #PAX-COUNT

    * Attempt re-accommodation
    CALLNAT 'REACCOM' BK-PNR-LOCATOR #AFFECTED-FLIGHT
      #OPTION #REACCOM-COUNT

    * Notify passenger
    CALLNAT 'NOTIFYPAX' BK-PNR-LOCATOR 'IROP-ALERT'
  END-FIND

  WRITE 'IROP PROCESSED:' #AFFECTED-FLIGHT
        'AFFECTED:' #PAX-COUNT
        'REACCOMMODATED:' #REACCOM-COUNT
END-FIND
END