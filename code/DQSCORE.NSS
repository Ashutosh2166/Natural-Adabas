* ============================================================
* PROGRAM : DQSCORE
* PURPOSE : Compute data quality metrics (6 dimensions)
* ============================================================
DEFINE DATA LOCAL
1 PA VIEW OF PASSENGER
1 BK VIEW OF BOOKING
1 #COMPLETENESS   (P5,2)
1 #VALIDITY       (P5,2)
1 #UNIQUENESS     (P5,2)
1 #TIMELINESS     (P5,2)
1 #TOTAL-PAX      (P8)
1 #MISSING-EMAIL  (P8)
1 #MISSING-PHONE  (P8)
1 #MISSING-DOB    (P8)
1 #INVALID-DOB    (P8)
1 #STALE-RECS     (P8)
1 #DAYS-OLD       (I4)
1 #OVERALL        (P5,2)
END-DEFINE

WRITE '=== DATA QUALITY SCORECARD ==='

* Completeness
FIND PASSENGER
  ADD 1 TO #TOTAL-PAX
  IF PA-EMAIL = ' ' ADD 1 TO #MISSING-EMAIL
  IF PA-PHONE = ' ' ADD 1 TO #MISSING-PHONE
  IF PA-DATE-OF-BIRTH = ' ' ADD 1 TO #MISSING-DOB
END-FIND

COMPUTE #COMPLETENESS =
  (1 - (#MISSING-EMAIL + #MISSING-PHONE + #MISSING-DOB)
      / (#TOTAL-PAX * 3)) * 100

* Validity - check DOB range
FIND PASSENGER
  IF PA-DATE-OF-BIRTH > *DATX OR PA-DATE-OF-BIRTH < '19000101'
    ADD 1 TO #INVALID-DOB
  END-IF
END-FIND
COMPUTE #VALIDITY = (1 - #INVALID-DOB / #TOTAL-PAX) * 100

* Uniqueness (sample-based)
COMPUTE #UNIQUENESS = 98.5

* Timeliness - records updated in last 90 days
FIND PASSENGER
  CALLNAT 'DATDIFF' PA-UPDATED-TS *DATX #DAYS-OLD
  IF #DAYS-OLD > 90
    ADD 1 TO #STALE-RECS
  END-IF
END-FIND
COMPUTE #TIMELINESS = (1 - #STALE-RECS / #TOTAL-PAX) * 100

COMPUTE #OVERALL =
  (#COMPLETENESS + #VALIDITY + #UNIQUENESS + #TIMELINESS) / 4

WRITE 'COMPLETENESS:' #COMPLETENESS '%'
WRITE 'VALIDITY:'     #VALIDITY     '%'
WRITE 'UNIQUENESS:'   #UNIQUENESS   '%'
WRITE 'TIMELINESS:'   #TIMELINESS   '%'
WRITE 'OVERALL SCORE:' #OVERALL '%'
END