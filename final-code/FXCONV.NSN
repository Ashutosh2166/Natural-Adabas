* ============================================================
* SUBPROGRAM: FXCONV
* PURPOSE   : Convert currency using daily rates
* ============================================================
DEFINE DATA
PARAMETER
1 P-FROM-CCY   (A3)
1 P-TO-CCY     (A3)
1 P-AMOUNT-IN  (P12,2)
1 P-AMOUNT-OUT (P12,2)
1 P-RATE-USED  (P9,6)
1 P-STATUS     (I2)
LOCAL
1 #RATE-FROM   (P9,6)
1 #RATE-TO     (P9,6)
1 #USD-AMT     (P12,2)
END-DEFINE

RESET P-STATUS P-AMOUNT-OUT P-RATE-USED

* Get rate to USD for both currencies
CALLNAT 'FXRATE' P-FROM-CCY 'USD' *DATX #RATE-FROM
CALLNAT 'FXRATE' P-TO-CCY   'USD' *DATX #RATE-TO

IF #RATE-FROM = 0 OR #RATE-TO = 0
  MOVE 50 TO P-STATUS
  ESCAPE ROUTINE
END-IF

COMPUTE #USD-AMT = P-AMOUNT-IN * #RATE-FROM
COMPUTE P-AMOUNT-OUT = #USD-AMT / #RATE-TO
COMPUTE P-RATE-USED = #RATE-FROM / #RATE-TO
MOVE 0 TO P-STATUS
END