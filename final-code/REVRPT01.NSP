* ============================================================
* PROGRAM : REVRPT01
* PURPOSE : Daily revenue report with CSV export
* ============================================================
DEFINE DATA LOCAL
1 FS VIEW OF FLIGHT-SCHEDULE
1 #RPT-DATE        (A10)
1 #LINE            (A200)
1 #TOTAL-REV       (P14,2)
1 #TOTAL-PAX       (P8)
1 #FLIGHT-CNT      (P6)
1 #AVG-LOAD        (P5,2)
1 #LOAD-SUM        (P8,2)
1 #REV            (P11,2)
1 #YIELD          (P9,4)
END-DEFINE

INPUT 'REPORT DATE (YYYY-MM-DD):' #RPT-DATE

DEFINE WORK FILE 3 '/aros/reports/revenue_' #RPT-DATE '.csv'
MOVE 'CARRIER,FLIGHT,ORIG,DEST,DEP_TIME,SEATS,PAX,LOAD%,REVENUE,YIELD'
  TO #LINE
WRITE WORK FILE 3 #LINE

FIND FLIGHT-SCHEDULE WITH FS-DEPARTURE-DATE = #RPT-DATE
  CALLNAT 'FLCNTBOOK' FS-FLIGHT-KEY #REV
  COMPUTE #YIELD = 0
  IF FS-SEATS-SOLD > 0 AND FS-DISTANCE-KM > 0
    COMPUTE #YIELD = #REV / (FS-SEATS-SOLD * FS-DISTANCE-KM)
  END-IF

  COMPRESS FS-CARRIER-CODE ',' FS-FLIGHT-NUMBER ','
    FS-ORIGIN-AIRPORT ',' FS-DEST-AIRPORT ','
    FS-SCHEDULED-DEP-TIME ',' FS-TOTAL-SEATS ','
    FS-SEATS-SOLD ',' FS-SEATS-SOLD * 100 / FS-TOTAL-SEATS ','
    #REV ',' #YIELD INTO #LINE
  WRITE WORK FILE 3 #LINE

  ADD #REV TO #TOTAL-REV
  ADD FS-SEATS-SOLD TO #TOTAL-PAX
  ADD 1 TO #FLIGHT-CNT
  COMPUTE #LOAD-SUM = #LOAD-SUM +
      FS-SEATS-SOLD * 100 / FS-TOTAL-SEATS
END-FIND

COMPUTE #AVG-LOAD = #LOAD-SUM / #FLIGHT-CNT

COMPRESS 'TOTAL,' #FLIGHT-CNT ',' #TOTAL-PAX ','
  ',' #TOTAL-REV ',' #AVG-LOAD INTO #LINE
WRITE WORK FILE 3 #LINE
CLOSE WORK FILE 3

WRITE 'REPORT GENERATED'
      'FLIGHTS:' #FLIGHT-CNT
      'TOTAL REVENUE:' #TOTAL-REV
      'AVG LOAD FACTOR:' #AVG-LOAD
END