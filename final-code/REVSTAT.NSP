* ============================================================
* PROGRAM : REVSTAT
* PURPOSE : Build/refresh statistics file for reporting
* ============================================================
DEFINE DATA LOCAL
1 FS VIEW OF FLIGHT-SCHEDULE
1 #STAT-KEY     (A30)
1 #DEP-DATE     (A10)
1 #CARRIER      (A3)
1 #ROUTE        (A7)
1 #LOAD-FACTOR  (P5,2)
1 #YIELD-RPK    (P9,4)
1 #REV          (P13,2)
END-DEFINE

FIND FLIGHT-SCHEDULE WITH FS-FLIGHT-STATUS = 'AR'
  #DEP-DATE := FS-DEPARTURE-DATE
  #CARRIER  := FS-CARRIER-CODE
  COMPRESS FS-ORIGIN-AIRPORT '-' FS-DEST-AIRPORT
    INTO #ROUTE

  CALLNAT 'FLCNTBOOK' FS-FLIGHT-KEY #REV

  IF FS-TOTAL-SEATS > 0
    COMPUTE #LOAD-FACTOR =
      FS-SEATS-SOLD * 100 / FS-TOTAL-SEATS
  END-IF

  IF FS-SEATS-SOLD > 0 AND FS-DISTANCE-KM > 0
    COMPUTE #YIELD-RPK =
      #REV / (FS-SEATS-SOLD * FS-DISTANCE-KM)
  END-IF

  COMPRESS #DEP-DATE #CARRIER #ROUTE INTO #STAT-KEY
  CALLNAT 'STATSAVE' #STAT-KEY #REV #LOAD-FACTOR #YIELD-RPK
END-FIND
END