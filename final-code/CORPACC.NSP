* ============================================================
* PROGRAM : CORPACC
* PURPOSE : Corporate travel account maintenance
* ============================================================
DEFINE DATA LOCAL
1 #CORP-ID        (A12)
1 #CORP-NAME      (A60)
1 #NEGO-RATE      (P3,2)
1 #YTD-SPEND      (P13,2)
1 #COMMIT-LEVEL   (P13,2)
1 #SELECTION      (A2)
1 #LOOP           (L)
END-DEFINE

REPEAT WHILE #LOOP = FALSE
  RESET #SELECTION
  INPUT 'CORPORATE MENU (1=ADD,2=VIEW,3=REPORT,9=EXIT):' #SELECTION

  DECIDE ON FIRST VALUE OF #SELECTION
    VALUE '1'
      INPUT 'CORP ID:' #CORP-ID
             'CORP NAME:' #CORP-NAME
             'NEGOTIATED RATE %:' #NEGO-RATE
             'YTD COMMITMENT:' #COMMIT-LEVEL
      CALLNAT 'CORPSAVE' #CORP-ID #CORP-NAME #NEGO-RATE #COMMIT-LEVEL
      WRITE 'CORPORATE ACCOUNT SAVED'

    VALUE '2'
      INPUT 'CORP ID:' #CORP-ID
      CALLNAT 'CORPFETCH' #CORP-ID #CORP-NAME #NEGO-RATE #YTD-SPEND
      DISPLAY 'NAME:' #CORP-NAME
              'NEGO RATE:' #NEGO-RATE
              'YTD SPEND:' #YTD-SPEND

    VALUE '3'
      CALLNAT 'CORPRPT' 'ALL'

    VALUE '9'
      MOVE TRUE TO #LOOP
    NONE
      WRITE 'INVALID OPTION'
  END-DECIDE
END-REPEAT
END