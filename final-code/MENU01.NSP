* ============================================================
* PROGRAM : MENU01
* PURPOSE : Airline Reservation System - Main Menu
* AUTHOR  : AROS Development Team
* DATE    : 2024-01-15
* ============================================================
DEFINE DATA LOCAL
1 #USER-ID       (A10)
1 #USER-ROLE     (A3)
1 #SELECTION     (A2)
1 #LOOP-FLAG     (L)
1 #MSG           (A79)
END-DEFINE

SET KEY PF1=NOP PF2=NOP PF3
SET CONTROL 'Z'
RESET #LOOP-FLAG

REPEAT WHILE #LOOP-FLAG = FALSE
  SET WINDOW 'AROS MAIN MENU'
  INPUT USING MAP 'MENU01M'
    #SELECTION
  DECIDE ON FIRST VALUE OF #SELECTION
    VALUE '01'
      FETCH 'RSVMAIN' 'RESERVATION MANAGEMENT'
    VALUE '02'
      FETCH 'SCHMAIN' 'FLIGHT SCHEDULING'
    VALUE '03'
      FETCH 'CRWMAIN' 'CREW MANAGEMENT'
    VALUE '04'
      FETCH 'CGO-MAIN' 'CARGO OPERATIONS'
    VALUE '05'
      FETCH 'REVMAIN' 'REVENUE MANAGEMENT'
    VALUE '06'
      FETCH 'MNTMAIN' 'AIRCRAFT MAINTENANCE'
    VALUE '07'
      FETCH 'LOYMAIN' 'LOYALTY PROGRAM'
    VALUE '08'
      FETCH 'REPTMAIN' 'REPORTING & ANALYTICS'
    VALUE '99'
      MOVE TRUE TO #LOOP-FLAG
    NONE
      MOVE 'INVALID SELECTION - PLEASE RETRY' TO #MSG
      REINPUT #MSG
  END-DECIDE
END-REPEAT
END